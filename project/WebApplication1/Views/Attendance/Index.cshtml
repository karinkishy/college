@{ ViewData["Title"] = "Посещаемость"; var students = (List<Student>)ViewBag.Students; var records = ((IReadOnlyList<(int StudentId, DateOnly Date, bool Present)>)ViewBag.Records); }
<div class="section-heading"><div><span class="eyebrow">УЧЁТ ЗАНЯТИЙ</span><h2>Посещаемость</h2></div></div><div class="panel"><div class="panel-head"><h3>Отметки посещаемости</h3><span class="muted">@records.Count записей</span></div><div class="table-wrap"><table><thead><tr><th>Студент</th><th>Дата занятия</th><th>Статус</th></tr></thead><tbody>@foreach(var r in records){var s=students.FirstOrDefault(x=>x.StudentId==r.StudentId);<tr><td>@(s == null ? "Удалённый студент" : $"{s.Name} {s.Surname}")</td><td>@r.Date.ToString("dd.MM.yyyy")</td><td><span class="status @(r.Present ? "present" : "absent")">@(r.Present ? "Присутствовал" : "Отсутствовал")</span></td></tr>}</tbody></table></div></div><div class="panel form-panel"><div class="panel-head"><div><span class="eyebrow">ОТМЕТИТЬ ЗАНЯТИЕ</span><h3>Новая отметка</h3></div></div><form asp-action="Mark" method="post" class="form-grid"><label>Студент<select name="studentId">@foreach(var s in students){<option value="@s.StudentId">@s.Name @s.Surname</option>}</select></label><label>Дата<input type="date" name="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required/></label><label>Статус<select name="present"><option value="true">Присутствовал</option><option value="false">Отсутствовал</option></select></label><button class="button">Сохранить отметку</button></form></div>
