@model IReadOnlyList<Student>
@{ ViewData["Title"] = "Студенты"; }
<div class="section-heading"><div><span class="eyebrow">СПИСОК УЧАЩИХСЯ</span><h2>Студенты <span class="count">@Model.Count</span></h2></div></div>
<div class="panel"><div class="panel-head"><h3>Все студенты</h3><span class="muted">Актуальный список</span></div><div class="table-wrap"><table><thead><tr><th>Студент</th><th>ID</th><th>Возраст</th><th>Группа</th></tr></thead><tbody>@foreach(var s in Model){<tr><td><span class="avatar">@s.Name[..1]@s.Surname[..1]</span><strong>@s.Name @s.Surname</strong></td><td>#@s.StudentId</td><td>@s.Age лет</td><td><span class="tag">@s.Group</span></td></tr>}</tbody></table></div></div>
<div class="panel form-panel"><div class="panel-head"><div><span class="eyebrow">НОВАЯ ЗАПИСЬ</span><h3>Добавить студента</h3></div></div><form asp-action="Create" method="post" class="form-grid"><label>Имя<input name="name" required /></label><label>Фамилия<input name="surname" required /></label><label>Возраст<input name="age" type="number" min="15" max="70" required /></label><label>Группа<input name="group" required placeholder="ИС-21" /></label><button class="button">Добавить студента</button></form></div>
