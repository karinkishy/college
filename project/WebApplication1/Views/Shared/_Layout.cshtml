<!doctype html>
<html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@(ViewData["Title"] ?? "Колледж") · College</title><link rel="stylesheet" href="~/css/site.css" /></head>
<body><aside class="sidebar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">C</span><span>COLLEGE<small>Управление колледжем</small></span></a><div class="nav-label">ОБЩЕЕ</div><a asp-controller="Home" asp-action="Index">⌂ <span>Главная</span></a><div class="nav-label">ОБУЧЕНИЕ</div><a asp-controller="Student" asp-action="Index">♙ <span>Студенты</span></a><a asp-controller="Teacher" asp-action="Index">♧ <span>Преподаватели</span></a><a asp-controller="Group" asp-action="Index">▦ <span>Учебные группы</span></a><a asp-controller="Grade" asp-action="Index">▤ <span>Журнал оценок</span></a><a asp-controller="Attendance" asp-action="Index">◷ <span>Посещаемость</span></a><div class="nav-label">СИСТЕМА</div><a asp-controller="Admin" asp-action="Index">⚙ <span>Администрирование</span></a></aside>
<main><header><div><span class="eyebrow">УПРАВЛЕНИЕ КОЛЛЕДЖЕМ</span><h1>@(ViewData["Title"] ?? "Главная")</h1></div><div class="header-right"><span class="year">2026—2027 учебный год</span><a class="user-pill" asp-controller="Home" asp-action="Login">● &nbsp;@(Context.Session.GetString("user") ?? "Войти")</a></div></header><section class="content">@if (TempData["Error"] != null) { <div class="alert">@TempData["Error"]</div> }@RenderBody()<footer>College Management <span>Учебная система · 2026</span></footer></section></main></body></html>
