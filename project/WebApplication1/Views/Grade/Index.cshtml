@model IReadOnlyList<Grade>
@{ ViewData["Title"] = "Журнал оценок"; var students = (List<Student>)ViewBag.Students; }
<div class="section-heading"><div><span class="eyebrow">УСПЕВАЕМОСТЬ</span><h2>Журнал оценок</h2></div><span class="muted">Оценки по пятибалльной шкале</span></div><div class="panel"><div class="panel-head"><h3>Последние оценки</h3><span class="tag">@Model.Count записей</span></div><div class="table-wrap"><table><thead><tr><th>Студент</th><th>Предмет</th><th>Дата</th><th>Оценка</th></tr></thead><tbody>@foreach(var g in Model.OrderByDescending(x=>x.Date)){<tr><td><strong>@g.StudentName</strong></td><td>@g.Subject</td><td>@g.Date.ToString("dd.MM.yyyy")</td><td><span class="grade grade-@g.Value">@g.Value</span></td></tr>}</tbody></table></div></div><div class="panel form-panel"><div class="panel-head"><div><span class="eyebrow">НОВАЯ ЗАПИСЬ</span><h3>Добавить оценку</h3></div></div><form asp-action="Create" method="post" class="form-grid"><label>Студент<select name="studentId">@foreach(var s in students){<option value="@s.StudentId">@s.Name @s.Surname</option>}</select></label><label>Предмет<input name="subject" required placeholder="Программирование"/></label><label>Оценка<select name="value"><option>5</option><option>4</option><option>3</option><option>2</option></select></label><button class="button">Сохранить оценку</button></form></div>
