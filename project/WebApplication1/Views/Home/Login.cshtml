@{ ViewData["Title"] = "Вход в систему"; }
<div class="panel login-panel"><span class="eyebrow">ДОБРО ПОЖАЛОВАТЬ</span><h2>Вход в систему</h2><p class="muted">Войдите, чтобы перейти к рабочей панели.</p>@if (ViewBag.Error != null) { <div class="alert">@ViewBag.Error</div> }<form method="post"><label>Логин<input name="login" required autocomplete="username" placeholder="Введите логин"/></label><label>Пароль<input name="password" type="password" required autocomplete="current-password" placeholder="Введите пароль"/></label><button class="button" type="submit">Войти →</button></form><small class="hint">Демо-доступ: admin / college123</small></div>
